# JobPilot Pro — copy this file to .env and edit

# Optional: better job scoring + cover notes (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# Full auto-submit: true = bot fills AND submits; false = fill only, you approve (safer default)
AUTO_SUBMIT=false
MIN_MATCH_SCORE=55
DAILY_APPLY_CAP=25

# Browser
HEADLESS=true
PORTAL_HEADLESS=false
OPEN_BROWSER=true
PORT=8000

# Email alerts (or configure in the dashboard under Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# Free phone push via ntfy.sh (install the app, create a private topic)
NTFY_TOPIC=

# Optional Adzuna India job API (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Scheduled search+apply every N minutes (0 = off)
RUN_EVERY_MINUTES=0
